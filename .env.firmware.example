# Copy to .env.firmware and fill in values for the firmware test device.
# This file is separate from .env, which holds the lab's Mosquitto credentials.

# Wi-Fi network used by the device
WIFI_SSID=replace-with-your-lab-wifi
WIFI_PASSWORD=replace-with-your-lab-wifi-password

# Broker address reachable from the device (use the Debian/Windows LAN IP,
# not the Docker service name "broker").
MQTT_HOST=192.168.1.10
# TLS: MQTT_TLS=1 with port 8883 (CA from `lab init`); MQTT_TLS=0 with 1883 for plaintext/PCAP analysis.
MQTT_PORT=8883
MQTT_TLS=1
# Host interface on which the Compose firmware override exposes port 1883.
BROKER_BIND_IP=192.168.1.10
MQTT_USERNAME=sensor
MQTT_PASSWORD=replace-with-sensor-password-from-dot-env
MQTT_CLIENT_ID=firmware-machine-01

# MQTT 3.1.1 sensor publishing settings
MQTT_TOPIC=factory/line-01/machine-01/telemetry
MQTT_QOS=1
PUBLISH_INTERVAL_MS=1000
DEVICE_ID=machine-01
